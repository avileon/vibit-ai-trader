# ===== VIBIT AI Trader — copy to .env (never commit .env) =====
# Paper only. Any other value makes api/worker refuse to start.
TRADING_MODE=paper
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# 32-byte key for encrypting API keys in the DB.  Generate:  openssl rand -base64 32
# Losing it = stored keys can't be decrypted (just re-enter them). Back it up separately from DB backups.
MASTER_KEY=

# MySQL passwords — generate:  openssl rand -hex 24   (hex: safe inside DATABASE_URL)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Risk base capital (USD). Risk engine uses min(account equity, this).
CAPITAL_BASE_USD=1000

# true in production behind HTTPS
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Web port binding. 127.0.0.1 = only via reverse proxy (recommended on a server).
WEB_BIND=127.0.0.1
WEB_PORT=3000
